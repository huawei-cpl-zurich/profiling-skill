#include "kernel_operator.h"
#include "acl/acl.h"
#include <cmath>
#include <cstdio>
#include <cstdlib>
#include <vector>
using namespace AscendC;

// Host already packed A as ZZ and B as ZN. LoadData preserves each 512B fractal.
extern "C" __global__ __aicore__ void a3_small_mmad(GM_ADDR ag, GM_ADDR bg, GM_ADDR cg,
                                                   int m, int n, int k) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);
    TPipe p;
    TBuf<TPosition::A1> a1buf;
    TBuf<TPosition::B1> b1buf;
    TBuf<TPosition::A2> a2buf;
    TBuf<TPosition::B2> b2buf;
    TBuf<TPosition::CO1> cbuf;
    p.InitBuffer(a1buf, m*k*2); p.InitBuffer(b1buf, k*n*2);
    p.InitBuffer(a2buf, m*k*2); p.InitBuffer(b2buf, k*n*2);
    p.InitBuffer(cbuf, m*n*4);
    auto a1 = a1buf.Get<half>(); auto b1 = b1buf.Get<half>();
    auto a2 = a2buf.Get<half>(); auto b2 = b2buf.Get<half>();
    auto c = cbuf.Get<float>();
    GlobalTensor<half> a, b; GlobalTensor<float> out;
    a.SetGlobalBuffer((__gm__ half*)ag, m*k);
    b.SetGlobalBuffer((__gm__ half*)bg, k*n);
    out.SetGlobalBuffer((__gm__ float*)cg, m*n);
    DataCopy(a1, a, m*k); DataCopy(b1, b, k*n);
    SetFlag<HardEvent::MTE2_MTE1>(0); WaitFlag<HardEvent::MTE2_MTE1>(0);
    LoadData2DParams lp;
    lp.startIndex = 0; lp.repeatTimes = m*k/256; lp.srcStride = 1;
    lp.dstGap = 0; lp.ifTranspose = false;
    LoadData(a2, a1, lp);
    lp.repeatTimes = k*n/256; LoadData(b2, b1, lp);
    SetFlag<HardEvent::MTE1_M>(0); WaitFlag<HardEvent::MTE1_M>(0);
    MmadParams mp;
    mp.m = m; mp.n = n; mp.k = k; mp.cmatrixInitVal = true;
    Mmad(c, a2, b2, mp);
    SetFlag<HardEvent::M_FIX>(0); WaitFlag<HardEvent::M_FIX>(0);
    FixpipeParamsV220 fp;
    fp.mSize = m; fp.nSize = n; fp.srcStride = m; fp.dstStride = m*16*4/32;
    Fixpipe<float, float, CFG_NZ>(out, c, fp);
    PipeBarrier<PIPE_ALL>();
}

size_t packed(int r, int c, int rows, int cols, int layout) {
    int block = layout == 2 ? c/16*(rows/16)+r/16 : r/16*(cols/16)+c/16;
    int inner = layout == 1 ? c%16*16+r%16 : r%16*16+c%16;
    return block*256+inner;
}
float value(int r, int c, int salt) { return ((r*3+c*5+salt)%17-8)/8.0f; }
#define CHECK(call) do { int code=(call); if(code) { \
    std::fprintf(stderr, "%s failed: %d\n", #call, code); return 2; } } while(0)
int main(int argc, char** argv) {
    if (argc != 4) return 2;
    int m=std::atoi(argv[1]), n=std::atoi(argv[2]), k=std::atoi(argv[3]);
    bool allowed=(m==n && n==k && (m==16 || m==32 || m==64 || m==128)) ||
                 (k==32 && ((m==16 && n==64) || (m==64 && n==16)));
    if (!allowed) return 2;
    std::vector<half> a(m*k), b(k*n);
    for(int r=0;r<m;++r) for(int c=0;c<k;++c) a[packed(r,c,m,k,0)]=(half)value(r,c,3);
    for(int r=0;r<k;++r) for(int c=0;c<n;++c) b[packed(r,c,k,n,1)]=(half)value(r,c,7);
    std::vector<float> out(m*n, -999);
    CHECK(aclInit(nullptr)); CHECK(aclrtSetDevice(0));
    aclrtStream stream; CHECK(aclrtCreateStream(&stream));
    void *ad, *bd, *cd;
    CHECK(aclrtMalloc(&ad,m*k*2,ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&bd,k*n*2,ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&cd,m*n*4,ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMemcpy(ad,m*k*2,a.data(),m*k*2,ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK(aclrtMemcpy(bd,k*n*2,b.data(),k*n*2,ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK(aclrtMemcpy(cd,m*n*4,out.data(),m*n*4,ACL_MEMCPY_HOST_TO_DEVICE));
    a3_small_mmad<<<1,nullptr,stream>>>((uint8_t*)ad,(uint8_t*)bd,(uint8_t*)cd,m,n,k);
    CHECK(aclrtSynchronizeStream(stream));
    CHECK(aclrtMemcpy(out.data(),m*n*4,cd,m*n*4,ACL_MEMCPY_DEVICE_TO_HOST));
    unsigned mismatches=0; float maxError=0;
    for(int r=0;r<m;++r) for(int c=0;c<n;++c) {
        float expected=0;
        for(int q=0;q<k;++q) expected+=value(r,q,3)*value(q,c,7);
        float actual=out[packed(r,c,m,n,2)];
        float error=std::abs(actual-expected); maxError=std::fmax(maxError,error);
        if(!std::isfinite(actual) || error!=0) {
            if(++mismatches<=3) std::fprintf(stderr,"(%d,%d): %g != %g\n",r,c,actual,expected);
        }
    }
    CHECK(aclrtFree(ad)); CHECK(aclrtFree(bd)); CHECK(aclrtFree(cd));
    CHECK(aclrtDestroyStream(stream)); CHECK(aclrtResetDevice(0)); CHECK(aclFinalize());
    std::printf("{\"correctness\":%s,\"mismatches\":%u,\"max_abs_error\":%g,\"m\":%d,\"n\":%d,\"k\":%d,\"layouts\":[\"ZZ\",\"ZN\",\"NZ\"]}\n",
                mismatches?"false":"true",mismatches,maxError,m,n,k);
    return mismatches?1:0;
}

#include "kernel_operator.h"
#include "acl/acl.h"
#include <cmath>
#include <cstdio>
#include <cstdlib>
#include <vector>
using namespace AscendC;

// Runtime mode changes ordering, not the paired cases' work or launch geometry.
extern "C" __global__ __aicore__ void a3_wait_cost_probe(
    GM_ADDR input, GM_ADDR output, int mode, int n, int rounds, int repetitions) {
    TPipe pipe;
    TBuf<TPosition::VECCALC> storage;
    pipe.InitBuffer(storage, 2 * n * sizeof(float));
    const TEventID vectorToLoad = pipe.AllocEventID<HardEvent::V_MTE2>();
    const TEventID loadToVector = pipe.AllocEventID<HardEvent::MTE2_V>();
    const TEventID vectorToStore = pipe.AllocEventID<HardEvent::V_MTE3>();
    auto a = storage.Get<float>();
    auto w = a[n];
    GlobalTensor<float> x, y;
    x.SetGlobalBuffer((__gm__ float*)input, n);
    y.SetGlobalBuffer((__gm__ float*)output, 2 * n);
    Duplicate(a, 0.0f, n);
    Duplicate(w, 0.0f, n);
    PipeBarrier<PIPE_V>();
    // Initialization must finish before MTE2 writes the same a buffer.
    if (mode != 1) SetFlag<HardEvent::V_MTE2>(vectorToLoad);
    for (int rep = 0; rep < repetitions; ++rep) {
        if (mode != 1) {
            WaitFlag<HardEvent::V_MTE2>(vectorToLoad);
            DataCopy(a, x, n);
            SetFlag<HardEvent::MTE2_V>(loadToVector);
            if (mode != 3) WaitFlag<HardEvent::MTE2_V>(loadToVector);
        }
        if (mode != 0) for (int r = 0; r < rounds; ++r) {
            Adds(w, w, 1.0f, n);
            PipeBarrier<PIPE_V>();
        }
        if (mode == 3) WaitFlag<HardEvent::MTE2_V>(loadToVector);
        // Do not reuse a/event until this iteration's wait has consumed it.
        if (mode != 1) SetFlag<HardEvent::V_MTE2>(vectorToLoad);
    }
    if (mode != 1) WaitFlag<HardEvent::V_MTE2>(vectorToLoad);
    pipe.ReleaseEventID<HardEvent::V_MTE2>(vectorToLoad);
    pipe.ReleaseEventID<HardEvent::MTE2_V>(loadToVector);
    SetFlag<HardEvent::V_MTE3>(vectorToStore);
    WaitFlag<HardEvent::V_MTE3>(vectorToStore);
    pipe.ReleaseEventID<HardEvent::V_MTE3>(vectorToStore);
    DataCopy(y, a, n);
    DataCopy(y[n], w, n);
    PipeBarrier<PIPE_ALL>();
}

#ifndef A3_WAIT_COST_KERNEL_ONLY
#define CHECK(call) do { int code = (call); if (code) { \
    std::fprintf(stderr, "%s failed: %d\n", #call, code); return 2; } } while (0)

int main(int argc, char** argv) {
    if (argc != 6) return 2;
    int mode = std::atoi(argv[1]), n = std::atoi(argv[2]), rounds = std::atoi(argv[3]);
    int repetitions = std::atoi(argv[4]), timing = std::atoi(argv[5]);
    if (mode < 0 || mode > 3 || (n != 1024 && n != 8192) ||
        (rounds != 1 && rounds != 32) || (repetitions != 1 && repetitions != 16) ||
        (timing != 0 && timing != 1)) return 2;
    CHECK(aclInit(nullptr)); CHECK(aclrtSetDevice(0));
    aclrtStream stream;
    CHECK(aclrtCreateStream(&stream));
    std::vector<float> input(n), actual(2 * n, -999), samples;
    for (int i = 0; i < n; ++i) input[i] = float(i % 17);
    void *x, *y;
    CHECK(aclrtMalloc(&x, n * 4, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&y, 2 * n * 4, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMemcpy(x, n * 4, input.data(), n * 4, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK(aclrtMemcpy(y, 2 * n * 4, actual.data(), 2 * n * 4, ACL_MEMCPY_HOST_TO_DEVICE));
    aclrtEvent start, end;
    if (timing) { CHECK(aclrtCreateEvent(&start)); CHECK(aclrtCreateEvent(&end)); }
    for (int launch = 0; launch < (timing ? 10 : 1); ++launch) {
        if (timing && launch >= 3) CHECK(aclrtRecordEvent(start, stream));
        a3_wait_cost_probe<<<1, nullptr, stream>>>((uint8_t*)x, (uint8_t*)y,
                                                  mode, n, rounds, repetitions);
        if (timing && launch >= 3) CHECK(aclrtRecordEvent(end, stream));
        CHECK(aclrtSynchronizeStream(stream));
        if (timing && launch >= 3) {
            float ms;
            CHECK(aclrtEventElapsedTime(&ms, start, end));
            if (!std::isfinite(ms) || ms <= 0) return 3;
            samples.push_back(ms * 1000);
        }
    }
    CHECK(aclrtMemcpy(actual.data(), 2 * n * 4, y, 2 * n * 4, ACL_MEMCPY_DEVICE_TO_HOST));
    unsigned mismatches = 0;
    for (int i = 0; i < n; ++i) {
        mismatches += actual[i] != (mode == 1 ? 0 : input[i]);
        mismatches += actual[n + i] != (mode == 0 ? 0 : rounds * repetitions);
    }
    if (timing) { CHECK(aclrtDestroyEvent(start)); CHECK(aclrtDestroyEvent(end)); }
    CHECK(aclrtFree(x)); CHECK(aclrtFree(y)); CHECK(aclrtDestroyStream(stream));
    CHECK(aclrtResetDevice(0)); CHECK(aclFinalize());
    std::printf("{\"correctness\":%s,\"mismatches\":%u,\"samples_us\":[",
                mismatches ? "false" : "true", mismatches);
    for (unsigned i = 0; i < samples.size(); ++i) std::printf("%s%.9g", i ? "," : "", samples[i]);
    std::printf("],\"warmup\":%d,\"launch_count\":%d}\n", timing ? 3 : 0, timing ? 7 : 1);
    return mismatches ? 1 : 0;
}
#endif

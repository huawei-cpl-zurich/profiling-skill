#include "acl/acl.h"
#include <cmath>
#include <cstdio>
#include <cstdlib>
#include <vector>
constexpr int kNativeWaitHostKind=TASK_KIND;
#include IMPLEMENTATION
#define CHECK(call) do { int rc=(call); if(rc) { std::fprintf(stderr,"%s failed: %d\n",#call,rc); return 2; } } while(0)
float host_reference_step(float w) {
    volatile float negative=w*-1.0f;
    volatile float complement=negative+1.0f;
    volatile float product=w*complement;
    volatile float result=product*4.0f;
    return result;
}
int main(int argc,char** argv) {
    if(argc!=9) return 2;
    unsigned state=std::strtoul(argv[1],nullptr,10);
    int n=std::atoi(argv[2]),rounds=std::atoi(argv[3]),reps=std::atoi(argv[4]);
    int imbalance=std::atoi(argv[5]),launches=std::atoi(argv[6]),device=std::atoi(argv[7]);
    int timing=std::atoi(argv[8]);
    if(n<=0 || rounds<1 || reps<1 || launches<1 || device<0 || (timing!=0 && timing!=1)) return 2;
    CHECK(aclInit(nullptr)); CHECK(aclrtSetDevice(device));
    aclrtStream stream; CHECK(aclrtCreateStream(&stream));
    int payloadVectors=kNativeWaitHostKind==3 && reps>2?reps:2;
    std::vector<float> input((payloadVectors+(kNativeWaitHostKind==1?2:1))*n),actual((kNativeWaitHostKind==1?4:2)*n,-999),expected(actual.size()),samples;
    for(unsigned j=0;j<input.size();++j) {
        state=1664525u*state+1013904223u;
        input[j]=(kNativeWaitHostKind==3 || j>=unsigned(payloadVectors*n))?
            float(state%65535+1)/65536:float(int(state%2049)-1024)/64;
    }
    for(int i=0;i<n;++i) {
        float w=input[payloadVectors*n+i];
        for(int rep=0;rep<(kNativeWaitHostKind==1?0:kNativeWaitHostKind==3?reps:1);++rep) {
            for(int r=0;r<rounds;++r) w=host_reference_step(w);
            if(kNativeWaitHostKind==3) {
                volatile float mixed=w+input[rep*n+i];
                volatile float scaled=mixed*0.25f;
                w=scaled;
            }
        }
        if(kNativeWaitHostKind==1) for(int b=0;b<2;++b) {
            expected[b*2*n+i]=input[b*n+i]+(imbalance && b==0?32:0);
            volatile float peer=input[(1-b)*n+i]+(imbalance && b==1?32:0);
            float own=input[(payloadVectors+b)*n+i];
            for(int r=0;r<rounds;++r) own=host_reference_step(own);
            expected[b*2*n+n+i]=own+peer;
        } else {
            volatile float sum=input[i]+input[n+i];
            expected[i]=kNativeWaitHostKind==2?sum+w:input[(reps-1)*n+i];
            expected[n+i]=w;
        }
    }
    void *x,*y;
    CHECK(aclrtMalloc(&x,input.size()*4,ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&y,actual.size()*4,ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMemcpy(x,input.size()*4,input.data(),input.size()*4,ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK(aclrtMemcpy(y,actual.size()*4,actual.data(),actual.size()*4,ACL_MEMCPY_HOST_TO_DEVICE));
    aclrtEvent start,end;
    if(timing) { CHECK(aclrtCreateEvent(&start)); CHECK(aclrtCreateEvent(&end)); }
    const int blocks=kNativeWaitHostKind==1?2:1;
    for(int i=0;i<(timing?10:launches);++i) {
        if(timing && i>=3) CHECK(aclrtRecordEvent(start,stream));
        task_kernel<<<blocks,nullptr,stream>>>((uint8_t*)x,(uint8_t*)y,n,rounds,reps,imbalance);
        if(timing && i>=3) CHECK(aclrtRecordEvent(end,stream));
        CHECK(aclrtSynchronizeStream(stream));
        if(timing && i>=3) {
            float ms; CHECK(aclrtEventElapsedTime(&ms,start,end));
            if(!std::isfinite(ms) || ms<=0) return 3;
            samples.push_back(ms*1000);
        }
    }
    CHECK(aclrtMemcpy(actual.data(),actual.size()*4,y,actual.size()*4,ACL_MEMCPY_DEVICE_TO_HOST));
    unsigned mismatches=0;
    for(unsigned i=0;i<actual.size();++i) mismatches+=!std::isfinite(actual[i]) || actual[i]!=expected[i];
    if(timing) { CHECK(aclrtDestroyEvent(start)); CHECK(aclrtDestroyEvent(end)); }
    CHECK(aclrtFree(x)); CHECK(aclrtFree(y)); CHECK(aclrtDestroyStream(stream));
    CHECK(aclrtResetDevice(device)); CHECK(aclFinalize());
    std::printf("{\"correctness\":%s,\"mismatches\":%u,\"warmup\":%d,\"samples_us\":[",mismatches?"false":"true",mismatches,timing?3:0);
    for(unsigned i=0;i<samples.size();++i) std::printf("%s%.9g",i?",":"",samples[i]);
    std::printf("]}\n"); return mismatches?1:0;
}

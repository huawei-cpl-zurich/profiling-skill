#include "kernel_operator.h"
#include "acl/acl.h"
#include <cmath>
#include <cstdio>
#include <cstdlib>
#include <vector>

using namespace AscendC;
constexpr uint32_t N = 4096;

__aicore__ inline void Work(LocalTensor<float> w, int rounds) {
    for (int r = 0; r < rounds; ++r) {
        Adds(w, w, 1.0f, N);
        PipeBarrier<PIPE_V>();
    }
}

extern "C" __global__ __aicore__ void a3_intra_probe(
    GM_ADDR input, GM_ADDR output, int family, int placement, int rounds) {
    TPipe p;
    TBuf<TPosition::VECCALC> storage;
    p.InitBuffer(storage, 3 * N * sizeof(float));
    const auto valueReady = p.AllocEventID<HardEvent::V_MTE3>();
    const auto workReady = p.AllocEventID<HardEvent::V_MTE3>();
    auto a = storage.Get<float>();
    auto b = a[N];
    auto w = a[2 * N];
    GlobalTensor<float> x, y;
    x.SetGlobalBuffer((__gm__ float*)input, 2 * N);
    y.SetGlobalBuffer((__gm__ float*)output, 2 * N);
    Duplicate(w, 0.0f, N);
    PipeBarrier<PIPE_V>();
    if (family == 0) {
        const auto firstInput = p.AllocEventID<HardEvent::MTE2_V>();
        const auto secondInput = p.AllocEventID<HardEvent::MTE2_V>();
        DataCopy(a, x, N);
        if (placement != 2) SetFlag<HardEvent::MTE2_V>(firstInput);
        DataCopy(b, x[N], N);
        if (placement == 2) SetFlag<HardEvent::MTE2_V>(firstInput);
        SetFlag<HardEvent::MTE2_V>(secondInput);
        if (placement == 1) WaitFlag<HardEvent::MTE2_V>(firstInput);
        Work(w, rounds);
        if (placement != 1) WaitFlag<HardEvent::MTE2_V>(firstInput);
        WaitFlag<HardEvent::MTE2_V>(secondInput);
        p.ReleaseEventID<HardEvent::MTE2_V>(firstInput);
        p.ReleaseEventID<HardEvent::MTE2_V>(secondInput);
        Add(a, a, b, N);
        PipeBarrier<PIPE_V>();
        Add(a, a, w, N);
        SetFlag<HardEvent::V_MTE3>(valueReady);
        WaitFlag<HardEvent::V_MTE3>(valueReady);
        DataCopy(y, a, N);
    } else {
        Duplicate(a, 2.0f, N);
        if (placement != 2) SetFlag<HardEvent::V_MTE3>(valueReady);
        if (placement == 1) WaitFlag<HardEvent::V_MTE3>(valueReady);
        Work(w, rounds);
        if (placement == 2) SetFlag<HardEvent::V_MTE3>(valueReady);
        if (placement != 1) WaitFlag<HardEvent::V_MTE3>(valueReady);
        DataCopy(y, a, N);
    }
    p.ReleaseEventID<HardEvent::V_MTE3>(valueReady);
    SetFlag<HardEvent::V_MTE3>(workReady);
    WaitFlag<HardEvent::V_MTE3>(workReady);
    p.ReleaseEventID<HardEvent::V_MTE3>(workReady);
    DataCopy(y[N], w, N);
    PipeBarrier<PIPE_ALL>();
}

// Two participants, one mode-0 barrier. Batch scheduling prevents partial dispatch deadlock.
extern "C" __global__ __aicore__ __schedmode__(1) void a3_inter0_probe(
    GM_ADDR output, int placement, int rounds, int imbalanced) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIV_1_0);
    TPipe p;
    TBuf<TPosition::VECCALC> storage;
    p.InitBuffer(storage, 2 * N * sizeof(float));
    const auto outputReady = p.AllocEventID<HardEvent::V_MTE3>();
    const auto inputReady = p.AllocEventID<HardEvent::MTE2_V>();
    auto w = storage.Get<float>();
    auto v = w[N];
    GlobalTensor<float> y;
    const uint32_t block = GetBlockIdx();
    y.SetGlobalBuffer((__gm__ float*)output, 4 * N);
    Duplicate(w, 0.0f, N);
    Duplicate(v, block == 0 ? 1.0f : 2.0f, N);
    PipeBarrier<PIPE_V>();
    if (imbalanced && block == 0) Work(v, 32);
    SetFlag<HardEvent::V_MTE3>(outputReady);
    WaitFlag<HardEvent::V_MTE3>(outputReady);
    DataCopy(y[block * 2 * N], v, N);
    CrossCoreSetFlag<0, PIPE_MTE3>(8);
    if (placement == 1) CrossCoreWaitFlag(8);
    Work(w, rounds);
    if (placement == 0) CrossCoreWaitFlag(8);
    DataCopy(v, y[(1 - block) * 2 * N], N);
    SetFlag<HardEvent::MTE2_V>(inputReady);
    WaitFlag<HardEvent::MTE2_V>(inputReady);
    p.ReleaseEventID<HardEvent::MTE2_V>(inputReady);
    Add(w, w, v, N);
    SetFlag<HardEvent::V_MTE3>(outputReady);
    WaitFlag<HardEvent::V_MTE3>(outputReady);
    p.ReleaseEventID<HardEvent::V_MTE3>(outputReady);
    DataCopy(y[block * 2 * N + N], w, N);
    PipeBarrier<PIPE_ALL>();
}

// Mode-2 handshake: both AIVs signal, AIC acknowledges. No high-level Matmul flags.
extern "C" __global__ __aicore__ __schedmode__(1) void a3_inter2_probe(
    GM_ADDR input, GM_ADDR output, int placement, int rounds, int imbalanced) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    TPipe p;
    if ASCEND_IS_AIC {
        TBuf<TPosition::A1> storage;
        p.InitBuffer(storage, N * sizeof(float));
        GlobalTensor<float> x;
        x.SetGlobalBuffer((__gm__ float*)input, N);
        auto a = storage.Get<float>();
        if (placement == 1) CrossCoreWaitFlag<2>(8);
        DataCopy(a, x, N);
        if (placement == 0) CrossCoreWaitFlag<2>(8);
        CrossCoreSetFlag<2, PIPE_MTE2>(9);
        PipeBarrier<PIPE_ALL>();
    }
    if ASCEND_IS_AIV {
        TBuf<TPosition::VECCALC> storage;
        p.InitBuffer(storage, N * sizeof(float));
        const auto outputReady = p.AllocEventID<HardEvent::V_MTE3>();
        auto w = storage.Get<float>();
        GlobalTensor<float> y;
        const uint32_t block = GetBlockIdx();
        y.SetGlobalBuffer((__gm__ float*)output, 4 * N);
        Duplicate(w, block == 0 ? 1.0f : block == 1 ? 2.0f : block == 2 ? 3.0f : 4.0f, N);
        PipeBarrier<PIPE_V>();
        Work(w, rounds + (imbalanced && GetSubBlockIdx() == 0 ? 32 : 0));
        SetFlag<HardEvent::V_MTE3>(outputReady);
        WaitFlag<HardEvent::V_MTE3>(outputReady);
        p.ReleaseEventID<HardEvent::V_MTE3>(outputReady);
        DataCopy(y[block * N], w, N);
        CrossCoreSetFlag<2, PIPE_MTE3>(8);
        CrossCoreWaitFlag<2>(9);
        PipeBarrier<PIPE_ALL>();
    }
}

#define ACL_CHECK(call) do { int code = (call); if (code) { \
    std::fprintf(stderr, "%s failed: %d\n", #call, code); return 2; } } while (0)

int main(int argc, char** argv) {
    if (argc != 5) return 2;
    int family = std::atoi(argv[1]), placement = std::atoi(argv[2]);
    int rounds = std::atoi(argv[3]), imbalanced = std::atoi(argv[4]);
    if (family < 0 || family > 3 || placement < 0 || placement > 2 ||
        (rounds != 1 && rounds != 32) || (family > 1 && placement == 2)) return 2;
    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(0));
    aclrtStream stream;
    ACL_CHECK(aclrtCreateStream(&stream));
    std::vector<float> input(2 * N), actual(4 * N, -999.0f), expected(4 * N, -999.0f);
    for (unsigned i = 0; i < input.size(); ++i) input[i] = float(i % 17);
    void *x, *y;
    ACL_CHECK(aclrtMalloc(&x, input.size() * 4, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&y, actual.size() * 4, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(x, input.size() * 4, input.data(), input.size() * 4, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(y, actual.size() * 4, actual.data(), actual.size() * 4, ACL_MEMCPY_HOST_TO_DEVICE));
    if (family < 2) {
        a3_intra_probe<<<1, nullptr, stream>>>((uint8_t*)x, (uint8_t*)y, family, placement, rounds);
        for (unsigned i = 0; i < N; ++i) {
            expected[i] = family == 0 ? input[i] + input[N + i] + rounds : 2;
            expected[N + i] = rounds;
        }
    } else if (family == 2) {
        a3_inter0_probe<<<2, nullptr, stream>>>((uint8_t*)y, placement, rounds, imbalanced);
        for (unsigned b = 0; b < 2; ++b) for (unsigned i = 0; i < N; ++i) {
            expected[b * 2 * N + i] = b + 1 + (imbalanced && b == 0 ? 32 : 0);
            expected[b * 2 * N + N + i] = rounds + 2 - b + (imbalanced && b == 1 ? 32 : 0);
        }
    } else {
        a3_inter2_probe<<<2, nullptr, stream>>>((uint8_t*)x, (uint8_t*)y, placement, rounds, imbalanced);
        for (unsigned b = 0; b < 4; ++b) for (unsigned i = 0; i < N; ++i)
            expected[b * N + i] = b + 1 + rounds + (imbalanced && b % 2 == 0 ? 32 : 0);
    }
    ACL_CHECK(aclrtSynchronizeStream(stream));
    ACL_CHECK(aclrtMemcpy(actual.data(), actual.size() * 4, y, actual.size() * 4, ACL_MEMCPY_DEVICE_TO_HOST));
    unsigned mismatch = 0;
    for (unsigned i = 0; i < actual.size(); ++i) if (actual[i] != expected[i]) {
        if (++mismatch <= 3) std::fprintf(stderr, "element %u: %g != %g\n", i, actual[i], expected[i]);
    }
    ACL_CHECK(aclrtFree(x)); ACL_CHECK(aclrtFree(y));
    ACL_CHECK(aclrtDestroyStream(stream)); ACL_CHECK(aclrtResetDevice(0)); ACL_CHECK(aclFinalize());
    std::printf("{\"correctness\":%s,\"mismatches\":%u,\"family\":%d,\"placement\":%d,\"rounds\":%d}\n",
                mismatch ? "false" : "true", mismatch, family, placement, rounds);
    return mismatch ? 1 : 0;
}

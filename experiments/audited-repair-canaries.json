      "treatment": "cannbot-new-profiler",
      "required_evidence": ["checkpoint-resume", "same-session", "offline-verifier", "msprof-op-timing"]
    },
    {
      "id": "matmul-guarded-new-profiler-repair",
      "treatment": "guarded-new-profiler",
      "required_evidence": ["candidate-repair", "offline-verifier", "msprof-op-timing"]
    },
    {
      "id": "matmul-guarded-old-profiler-repair",
      "treatment": "guarded-old-profiler",
      "required_evidence": ["candidate-repair", "offline-verifier", "msprof-op-timing"]
    }

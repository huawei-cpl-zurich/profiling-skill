#include "acl/acl.h"
#include <cmath>
#include <cstdio>
#include <cstdlib>
#include <vector>
#include IMPLEMENTATION
#define CHECK(call) do { int rc=(call); if(rc) { std::fprintf(stderr,"%s failed: %d\n",#call,rc); return 2; } } while(0)
int main(int argc, char **argv) {
    if(argc != 4) return 2;
    unsigned state=std::strtoul(argv[1],nullptr,10);
    int launches=std::atoi(argv[2]), device=std::atoi(argv[3]);
    if(launches<1 || device<0) return 2;
    CHECK(aclInit(nullptr)); CHECK(aclrtSetDevice(device));
    aclrtStream stream; CHECK(aclrtCreateStream(&stream));
    constexpr unsigned count=4096;
    std::vector<float> input(2*count),actual(2*count),expected(2*count);
    for(unsigned i=0;i<2*count;++i) { state=1664525u*state+1013904223u; input[i]=float(int(state%2049)-1024)/64; }
    for(unsigned i=0;i<count;++i) { expected[i]=input[i]+input[count+i]+32; expected[count+i]=32; }
    void *x,*y;
    CHECK(aclrtMalloc(&x,input.size()*4,ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&y,actual.size()*4,ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMemcpy(x,input.size()*4,input.data(),input.size()*4,ACL_MEMCPY_HOST_TO_DEVICE));
    for(int launch=0;launch<launches;++launch) task_kernel<<<1,nullptr,stream>>>((uint8_t*)x,(uint8_t*)y);
    CHECK(aclrtSynchronizeStream(stream));
    CHECK(aclrtMemcpy(actual.data(),actual.size()*4,y,actual.size()*4,ACL_MEMCPY_DEVICE_TO_HOST));
    unsigned mismatches=0;
    for(unsigned i=0;i<actual.size();++i) if(!std::isfinite(actual[i]) || std::fabs(actual[i]-expected[i])>.02f+.02f*std::fabs(expected[i])) {
        if(++mismatches<4) std::fprintf(stderr,"element %u: %g != %g\n",i,actual[i],expected[i]);
    }
    CHECK(aclrtFree(x)); CHECK(aclrtFree(y)); CHECK(aclrtDestroyStream(stream));
    CHECK(aclrtResetDevice(device)); CHECK(aclFinalize());
    std::printf("{\"correctness\":%s,\"mismatches\":%u,\"selector\":\"task_kernel\"}\n",mismatches?"false":"true",mismatches);
    return mismatches?1:0;
}

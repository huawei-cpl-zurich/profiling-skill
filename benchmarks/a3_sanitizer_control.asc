#include "kernel_operator.h"
#include "acl/acl.h"
#include <cstdio>
#include <cstdlib>
#include <vector>
using namespace AscendC;
constexpr uint32_t N = 4096;

extern "C" __global__ __aicore__ __schedmode__(1) void a3_sanitizer_control(
    GM_ADDR input, GM_ADDR output, int family, int mutant) {
    TPipe p;
    TBuf<TPosition::VECCALC> storage;
    p.InitBuffer(storage, N * sizeof(float));
    auto a = storage.Get<float>();
    GlobalTensor<float> x, y;
    x.SetGlobalBuffer((__gm__ float*)input, N);
    y.SetGlobalBuffer((__gm__ float*)output, 4 * N);
    if (family == 4) { // GM producer/consumer across two AIV participants.
        Duplicate(a, 2.0f, N);
        SetFlag<HardEvent::V_MTE3>(0);
        WaitFlag<HardEvent::V_MTE3>(0);
        DataCopy(y[GetBlockIdx() * N], a, N);
        if (!mutant) {
            CrossCoreSetFlag<0, PIPE_MTE3>(8);
            CrossCoreWaitFlag(8);
        }
        DataCopy(a, y[(1 - GetBlockIdx()) * N], N);
        SetFlag<HardEvent::MTE2_MTE3>(0);
        WaitFlag<HardEvent::MTE2_MTE3>(0);
        DataCopy(y[(GetBlockIdx() + 2) * N], a, N);
        PipeBarrier<PIPE_ALL>();
        return;
    }
    if (family == 0) { // RAW: MTE2 writes UB, vector reads UB.
        DataCopy(a, x, N);
        if (!mutant) {
            SetFlag<HardEvent::MTE2_V>(0);
            WaitFlag<HardEvent::MTE2_V>(0);
        }
        Adds(a, a, 1.0f, N);
    } else if (family == 1) { // WAR: MTE3 reads UB, vector overwrites UB.
        Duplicate(a, 1.0f, N);
        SetFlag<HardEvent::V_MTE3>(0);
        WaitFlag<HardEvent::V_MTE3>(0);
        DataCopy(y, a, N);
        if (!mutant) {
            SetFlag<HardEvent::MTE3_V>(0);
            WaitFlag<HardEvent::MTE3_V>(0);
        }
        Duplicate(a, 2.0f, N);
    } else if (family == 2) { // WAW: MTE2 and vector write the same UB.
        DataCopy(a, x, N);
        if (!mutant) {
            SetFlag<HardEvent::MTE2_V>(0);
            WaitFlag<HardEvent::MTE2_V>(0);
        }
        Duplicate(a, 2.0f, N);
    } else { // Inter-core non-atomic GM writes; control has disjoint ownership.
        Duplicate(a, 2.0f, N);
    }
    SetFlag<HardEvent::V_MTE3>(1);
    WaitFlag<HardEvent::V_MTE3>(1);
    uint32_t offset = family == 3 && !mutant ? GetBlockIdx() * N : 0;
    if (family == 1) offset = N;
    DataCopy(y[offset], a, N);
    PipeBarrier<PIPE_ALL>();
}

#define CHECK(call) do { int code = (call); if (code) { \
    std::fprintf(stderr, "%s: %d\n", #call, code); return 2; } } while (0)

int main(int argc, char** argv) {
    if (argc != 3) return 2;
    int family = std::atoi(argv[1]), mutant = std::atoi(argv[2]);
    if (family < 0 || family > 4 || mutant < 0 || mutant > 1) return 2;
    CHECK(aclInit(nullptr)); CHECK(aclrtSetDevice(0));
    aclrtStream stream; CHECK(aclrtCreateStream(&stream));
    std::vector<float> input(N, 1.0f), actual(4 * N, 0.0f);
    void *x, *y;
    CHECK(aclrtMalloc(&x, N * 4, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&y, 4 * N * 4, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMemcpy(x, N * 4, input.data(), N * 4, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK(aclrtMemcpy(y, 4 * N * 4, actual.data(), 4 * N * 4, ACL_MEMCPY_HOST_TO_DEVICE));
    a3_sanitizer_control<<<family >= 3 ? 2 : 1, nullptr, stream>>>(
        (uint8_t*)x, (uint8_t*)y, family, mutant);
    CHECK(aclrtSynchronizeStream(stream));
    CHECK(aclrtMemcpy(actual.data(), 4 * N * 4, y, 4 * N * 4, ACL_MEMCPY_DEVICE_TO_HOST));
    unsigned mismatch = 0;
    for (unsigned i = 0; i < 4 * N; ++i) {
        float expected = i < N ? (family == 1 ? 1.0f : 2.0f) :
                         (family == 1 || (family == 3 && !mutant) ? 2.0f : 0.0f);
        if (i >= 2 * N) expected = 0;
        if (family == 4) expected = 2;
        if (actual[i] != expected) ++mismatch;
    }
    CHECK(aclrtFree(x)); CHECK(aclrtFree(y)); CHECK(aclrtDestroyStream(stream));
    CHECK(aclrtResetDevice(0)); CHECK(aclFinalize());
    std::printf("{\"correctness\":%s,\"mutant\":%d,\"mismatches\":%u}\n",
                mismatch ? "false" : "true", mutant, mismatch);
    // A race mutant may legitimately produce a wrong value; its report remains evidence.
    return mismatch && !mutant ? 1 : 0;
}
